APP_NAME=ViewsMax
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Optional: mirror errors to a Slack channel. Leave the webhook blank to
# disable it — errors still go to the log file as normal.
# Setup guide: README/SLACK_ERROR_LOGGING.md
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="ViewsMax Error Bot"
LOG_SLACK_EMOJI=:warning:
LOG_SLACK_LEVEL=error

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Logs emails, you can use MailTra sandbox to test in action
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
FRONTEND_URL=

# Comma-separated extra CORS origins for your deployed frontend
# e.g. https://viewsmax.com,https://app.example.com
CORS_ALLOWED_ORIGINS=
BREVO_API_KEY=

THUMBNAIL_SERVICE=gemini|openai|flux|flux2
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
# Google Cloud project ID
GEMINI_PROJECT_ID=
# Region; defaults to us-central1
GEMINI_LOCATION=
# Imagen model; defaults to imagen-3.0-generate-002
GEMINI_MODEL=

REPLICATES_API_KEY=
REPLICATES_API_URL=
REPLICATES_MODEL_VERSION=
REPLICATES_DESTINATION_NAMESPACE=

HUGGINGFACE_API_KEY=
HUGGINGFACE_API_URL=
HUGGINGFACE_NAMESPACE=viewsmax
HUGGINGFACE_MODEL_TYPE=
YOUTUBE_TRANSCRIPT_API_KEY=
ANTHROPIC_API_KEY=

# ComfyUI Configuration
COMFYUI_SERVER_URL=
COMFYUI_ENABLED=true
COMFYUI_LORA_PATH=models/loras
COMFYUI_DEFAULT_STEPS=35          # 30-40 recommended
COMFYUI_DEFAULT_CFG=3.5           # 3.5-5.0 for Flux model
COMFYUI_DEFAULT_WIDTH=1280
COMFYUI_DEFAULT_HEIGHT=720

# SSH settings for LoRA upload via SCP
COMFYUI_SSH_HOST=
COMFYUI_SSH_USER=ubuntu
COMFYUI_SSH_KEY_PATH=
COMFYUI_REMOTE_LORA_PATH=/home/ubuntu/ComfyUI/models/loras

# Thumbnail service selection (replicate or comfyui)
AI_MODEL_THUMBNAIL_SERVICE=comfyui

COPY_THUMBNAIL_WIDTH=1024
COPY_THUMBNAIL_HEIGHT=1024
COPY_THUMBNAIL_DW_POSE_ENABLED=false

SCRIPT_VERSION_LIMIT=50
SCRIPT_VERSION_INTERVAL=300

# --- Stripe ---
STRIPE_KEY=pk_test_xxx                 # Publishable key
STRIPE_SECRET=sk_test_xxx              # Secret key
STRIPE_WEBHOOK_SECRET=whsec_xxx        # Webhook signing secret
STRIPE_SIGNATURE_CHECK=true            # set false ONLY for local testing without the CLI/secret

STRIPE_TRIAL_PRICE_ID=price_xxx        # the $29.99/mo recurring price (required for trial signup)
STRIPE_TRIAL_PERIOD_DAYS=7

STRIPE_DEFAULT_PLAN=creator_pro        # matches your PlanSeeder; leave as-is
SUBSCRIPTION_GRACE_PERIOD_HOURS=24

# Where Stripe Checkout returns the user (frontend routes)
STRIPE_SUCCESS_URL=http://localhost:8080/billing/success
STRIPE_CANCEL_URL=http://localhost:8080/billing/cancel
# Billing Portal return URL (past_due recovery)
STRIPE_PORTAL_RETURN_URL=http://localhost:8080/dashboard/billing

# --- Plan price IDs (TEST prices; swap for live in prod, then re-seed PlanSeeder) ---
STRIPE_PRICE_STARTER=# $29/mo
STRIPE_PRICE_CREATOR=# $59/mo
STRIPE_PRICE_PRO=# $99/mo
STRIPE_PRICE_AGENCY=# $149/mo

# --- Per-tier limits (blank = unlimited) ---
LIMIT_FREE_CHANNELS=0
LIMIT_FREE_OFFERS=0
LIMIT_FREE_POSTS=0

LIMIT_STARTER_CHANNELS=5
LIMIT_STARTER_OFFERS=1
LIMIT_STARTER_POSTS=400

LIMIT_CREATOR_CHANNELS=30
LIMIT_CREATOR_OFFERS=5
LIMIT_CREATOR_POSTS=                  # unlimited

LIMIT_PRO_CHANNELS=                   # unlimited
LIMIT_PRO_OFFERS=10
LIMIT_PRO_POSTS=                      # unlimited

LIMIT_AGENCY_CHANNELS=                # unlimited
LIMIT_AGENCY_OFFERS=                  # unlimited
LIMIT_AGENCY_POSTS=                   # unlimited

S3_ACCESS_KEY=
S3_SECRET=
ARN=

# --- Facebook + Instagram (same Meta app) ---
# https://developers.facebook.com/apps  →  add "Facebook Login" + "Instagram Graph API"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0

# --- Threads (separate Meta "Threads API" app) ---
# https://developers.facebook.com/  →  create app with "Threads API" use case
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# --- LinkedIn ---
# https://www.linkedin.com/developers/apps  →  request "Share on LinkedIn" + "Sign In with OpenID"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- X / Twitter (OAuth 2.0, with PKCE) ---
# https://developer.x.com/  →  app with OAuth2, scopes incl. tweet.write + offline.access + media.write
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- TikTok ---
# https://developers.tiktok.com/  →  Login Kit + Content Posting API (video.publish)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Bluesky --- (no app to register; users connect with handle + app password)
BLUESKY_SERVICE_URL=https://bsky.social

# --- YouTube + Google My Business (reuse existing Google OAuth app) ---
# Already have GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET for YouTube OAuth.
# In Google Cloud Console, ADD these scopes/APIs to the SAME OAuth consent screen:
#   - YouTube Data API v3  (youtube.upload)
#   - Business Profile APIs (business.manage)  ← request access, it needs approval
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Instagram (same Meta app as Facebook, above) ---
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── Media storage ────────────────────────────────────────────────────────────
# Where user-uploaded post media (images / video) is stored.
#
#   local  (default) — files are written to storage/app. No account needed and
#                      everything else in the app works, but publishing to
#                      platforms that fetch media by public URL (Instagram,
#                      TikTok) will NOT work, because those platforms have to be
#                      able to reach the file over public HTTPS.
#
#   r2 / s3          — any S3-compatible object storage. Required for real
#                      publishing. The 'r2' disk uses Laravel's standard S3
#                      driver with a custom endpoint, so it works with
#                      Cloudflare R2, AWS S3, Backblaze B2, DigitalOcean
#                      Spaces, Wasabi, MinIO, etc.
MEDIA_DISK=local

# Fill these in and set MEDIA_DISK=r2 to use hosted storage.
# The example values below are shaped for Cloudflare R2; for another provider
# use its own endpoint/region and leave the rest as-is.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_URL=https://pub-<hash>.r2.dev
R2_DEFAULT_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true

# MCP server (/api/mcp) rate limits and upload cap. Defaults shown; all optional.
MCP_RATE_PER_MINUTE=120
MCP_CREATE_POST_PER_HOUR=180
MCP_UPLOAD_MEDIA_PER_HOUR=40
MCP_UPLOAD_MAX_MB=100
MCP_FAILED_AUTH_PER_MINUTE=20
MCP_KEY_ROTATE_PER_HOUR=12
