{
    "name": "viewsmax/seo-engine",
    "description": "Automated SEO engine: discovers high-intent competitor keywords (DataForSEO), drafts articles (Anthropic), publishes to WordPress, and prospects backlink opportunities.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://viewsmax.com",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "ViewsMax\\SeoEngine\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ViewsMax\\SeoEngine\\SeoEngineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
