VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_PLAN_ID=
VITE_YOUTUBE_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE_URL=
VITE_VERSION=
VITE_USE_MOCK_API=true
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_TIKTOK_CLIENT_KEY=
VITE_INSTAGRAM_CLIENT_ID=

# --- Analytics / tracking (all optional; blank = that tracker never loads) ---
# Trackers only run when the page is served from this hostname, and never for
# admin users. Leave blank to disable all tracking (e.g. local development).
VITE_TRACKING_HOSTNAME=
# Meta (Facebook) Pixel. Comma-separate several IDs to init more than one pixel.
VITE_META_PIXEL_ID=
# Google Tag Manager container (GTM-XXXXXXX)
VITE_GTM_ID=
# Google Analytics 4 measurement id (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
# Microsoft Clarity project id
VITE_CLARITY_ID=
# Rewardful affiliate tracking id (the data-rewardful value)
VITE_REWARDFUL_ID=
# Public user id for the ViewsMax universal tracker, which is served from
# VITE_API_BASE_URL/tracker.js (backend/public/tracker.js)
VITE_VIEWSMAX_TRACKER_USER=

# --- AI agent directory listings (optional; blank = listing button hidden) ---
# Set once ViewsMax is approved in each directory, then rebuild. The agent pages
# then lead with the listing and move the manual setup into a collapsed section.
# Must be an https URL.
# Claude connector directory: /claude, /claude-cowork, /claude-code (Claude Code
# picks up claude.ai connectors). e.g. https://claude.ai/directory/connectors/<slug>
VITE_CLAUDE_CONNECTOR_URL=
# ChatGPT + Codex plugin directory (shared): /chatgpt, /codex.
# e.g. https://chatgpt.com/plugins/<id>
VITE_CHATGPT_PLUGIN_URL=
