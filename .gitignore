# Root-level ignores. frontend/ and backend/ each keep their own .gitignore
# for language-specific artefacts (vendor/, node_modules/, build output).

.DS_Store
Thumbs.db

# Never commit real environment files — only the .env.example templates.
.env
.env.*
!.env.example

# Editor / tooling
/.idea
/.vscode
/.fleet
/.zed

tsconfig.app.tsbuildinfo
tsconfig.node.tsbuildinfo